# Test Environment Configuration
NODE_ENV=test
PORT=3001
JWT_SECRET=test-jwt-secret-key

# Test Database (SQLite in-memory for fast testing)
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USERNAME=test_user
DATABASE_PASSWORD=test_password
DATABASE_NAME=nestjs_test_db

# TypeORM Test Configuration
TYPEORM_HOST=localhost
TYPEORM_PORT=5433
TYPEORM_USERNAME=test_user
TYPEORM_PASSWORD=test_password
TYPEORM_DATABASE=nestjs_test_db
TYPEORM_SYNCHRONIZE=true
TYPEORM_LOGGING=false
TYPEORM_DROP_SCHEMA=true